{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "评审意见",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "comments"
  ],
  "properties": {
    "status": {
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "comment"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "changes_requested"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "comments": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
